+function generateIndent(indent, command, options) {
+  // Dedent drops the trailing command, so the value can no longer be derived
+  // incrementally and the shortened queue has to be rendered from scratch.
+  // This is the rare path (only reached by negative-width alignment).
+  if (command.type === INDENT_COMMAND_TYPE_DEDENT) {
+    const queue = indent.queue.slice(0, -1);
+    const { value, length } = renderQueue(queue, options);
+    return { value, length, queue, root: indent.root };
+  }
+
+  // Append a single command onto the fully-flushed parent indent in O(1).
+  const { value, length } = appendCommand(indent, command, options);
+  return {
+    value,
+    length,
+    queue: [...indent.queue, command],
+    root: indent.root,
+  };
+}
