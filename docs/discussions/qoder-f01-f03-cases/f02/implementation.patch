+/**
+Extends an already-rendered indent by a single appended command.
+
+Every `Indent` produced by this module is fully flushed (no pending tab/space
+run), so the appended command is also the last one in the new queue and is
+always flushed by the trailing `flushSpaces()`. That lets us compute the new
+value/length directly from the parent instead of walking the whole queue.
+
+@param {Indent} indent
+@param {IndentCommand} command
+@param {IndentOptions} options
+@returns {{value: string, length: number}}
+*/
+function appendCommand(indent, command, options) {
+  switch (command.type) {
+    case INDENT_COMMAND_TYPE_INDENT:
+      return options.useTabs
+        ? { value: indent.value + "\t", length: indent.length + options.tabWidth }
+        : {
+            value: indent.value + " ".repeat(options.tabWidth),
+            length: indent.length + options.tabWidth,
+          };
+    case INDENT_COMMAND_TYPE_STRING:
+      return {
+        value: indent.value + command.string,
+        length: indent.length + command.string.length,
+      };
+    case INDENT_COMMAND_TYPE_WIDTH: {
+      const { width } = command;
+      // Trailing width commands are always flushed as spaces (see renderQueue).
+      if (width <= 0) {
+        return { value: indent.value, length: indent.length };
+      }
+      return {
+        value: indent.value + " ".repeat(width),
+        length: indent.length + width,
+      };
+    }
+    /* c8 ignore next */
+    default:
+      throw new Error(`Unexpected indent comment '${command.type}'.`);
+  }
+}
