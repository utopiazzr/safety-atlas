+        return path.resolve(configDirectory, value);
+      }
+      // Already absolute: points at a file.
+      if (path.isAbsolute(value)) {
+        return value;
+      }
+      // Bare package specifier, including subpath exports: resolve against
+      // the config directory. Fall back to the original specifier when it is
+      // not installed there, keeping the loader's established resolution.
+      try {
+        return new URL(resolveModule(value, parentURL));
+      } catch {
+        return value;
+      }
+    });
